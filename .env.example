# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only. NEVER expose to the client.
# Required for user invites (Admin API). Leave blank to disable invites.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used to build auth email redirect links (e.g. password reset).
# Optional in development; falls back to the request host. Set in production.
NEXT_PUBLIC_SITE_URL=
